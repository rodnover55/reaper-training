Mode -[hidden]down-> RunTimeline
BarLabels -[hidden]down-> BarLabel
Bars -[hidden]down-> GridBarRow
GridBarRow -[hidden]down-> RowBeat
RowBeat -[hidden]down-> RowSlot
RowSlot -[hidden]down-> NodeHit
NodeHit -[hidden]down-> GridNodes

