CoreTimeline *-- CoreBar
CoreTimeline ..> CorePosition
CorePosition --> CoreDivision
CoreBar ..> CoreDivision
CoreBar *-- CoreNote
CoreNote --> CoreHit
Transport ..|> BarReceiver
Transport *-- CoreTimeline

BarRows ..> CoreTimeline
RenderBarRow ..> CoreBar

RunTimeline ..|> TempoMap
CountInTimeline ..|> TempoMap
ProjectTimeline ..|> TempoMap
