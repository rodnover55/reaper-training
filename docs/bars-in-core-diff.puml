src -[hidden]down-> reaper
reaper -[hidden]down-> render
render -[hidden]down-> trainer
trainer -[hidden]down-> core
render -[hidden]right-> grid
CoreTimeline -[hidden]down-> CorePosition
CorePosition -[hidden]down-> CoreDivision
CoreBar -[hidden]down-> CoreNote
CoreNote -[hidden]down-> CoreHit
BarReceiver -[hidden]down-> CoreSettings
TempoMap -[hidden]down-> ReaperPosition
