' --- раскладка: слои сверху вниз ---------------------------------------------------

src -[hidden]down-> trainer
reaper -[hidden]down-> trainer
trainer -[hidden]down-> core
CoreAudioBlock -[hidden]down-> CoreMidiNote
SoundReceiver -[hidden]down-> MidiReceiver
OnsetSearch -[hidden]down-> AudioOnset
Calibrator -[hidden]down-> TrainerAudioBlock
AudioOnset -[hidden]down-> MidiNotes
TrainerAudioBlock -[hidden]down-> TrainerMidiNote
ReaperInput -[hidden]down-> MidiPlaces
ReaperMidiEvent -[hidden]down-> LoopTimeline
ReaperMidiRead -[hidden]down-> Run
AudioInput -[hidden]down-> BlockHeader

' --- связи ---------------------------------------------------------------------

OnsetSearch ..|> SoundReceiver
Calibrator ..|> SoundReceiver
MidiNotes ..|> MidiReceiver
LoopTimeline ..|> CoreTimeline

SoundReceiver ..> CoreAudioBlock
MidiReceiver ..> CoreMidiNote
OnsetSearch --> SoundEvents
OnsetSearch ..> AudioOnset
Transport *-- OnsetSearch
Transport ..|> SoundReceiver
Transport ..|> MidiReceiver
Transport *-- Bars
Transport *-- MidiNotes
Transport ..> PlacedNote
Transport --> NoteEvents
Transport ..> CoreTimeline

TrainerAudioBlock ..> CoreAudioBlock : заменён
TrainerMidiNote ..> CoreMidiNote : заменён

AudioInput --> SoundReceiver : подаёт блоки
MidiPlaces ..> CoreMidiNote : отдаёт ноты
MidiPlaces ..> ReaperMidiEvent
MidiPlaces ..> ReaperMidiRead
ReaperMidiRead --> ReaperInput
InputSettings --> ReaperInput

