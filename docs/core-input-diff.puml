@startuml core-input-diff
title Поставка данных в ядро: изменения типов (только дифф)

' Показаны только новые, изменённые, удалённые и перенесённые типы и только их
' изменённые члены. Остальные типы и члены не меняются.

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 50

skinparam class {
  BackgroundColor<<новый>> #E8F5E9
  BorderColor<<новый>> #2E7D32
  BackgroundColor<<изменён>> #FFF8E1
  BorderColor<<изменён>> #F9A825
  BackgroundColor<<удалён>> #FFEBEE
  BorderColor<<удалён>> #C62828
  BackgroundColor<<перенесён>> #E3F2FD
  BorderColor<<перенесён>> #1565C0
}

legend top left
  |= Блок |= Что значит |
  |<back:#E8F5E9>   новый   </back>| новый тип |
  |<back:#FFF8E1>  изменён  </back>| тип остаётся, меняются показанные члены |
  |<back:#FFEBEE>  удалён   </back>| тип убирается |
  |<back:#E3F2FD> перенесён </back>| тип переезжает в этот слой без изменений |
  | <color:#2E7D32>+ член</color> | добавляется |
  | <color:#C62828><s>член</s></color> | убирается |
endlegend

package "libs/core — training::core" as core #F5F6FC {

  class "training::core::AudioBlock" as CoreAudioBlock <<новый>> <<struct>> {
    <color:#2E7D32>+ std::span<const float> samples</color>
    <color:#2E7D32>+ training::core::Moment start</color>
  }
  note right of CoreAudioBlock
    Блок звука выбранного канала.
    samples — доли полной шкалы, их число — длина блока.
    start — время первого сэмпла.
  end note

  interface "training::core::SoundReceiver" as SoundReceiver <<новый>> {
    <color:#2E7D32>+ void setSampleRate(double sampleRate)</color>
    <color:#2E7D32>+ void receive(const training::core::AudioBlock &block)</color>
  }
  note right of SoundReceiver
    Один интерфейс поставки звука
    для поиска атак и калибровки.
    Блоки принимаются в любом состоянии.
    Начало блока раньше конца разобранного
    звука — уже разобранная часть отрезается.
  end note

  interface "training::core::SoundEvents" as SoundEvents <<новый>> {
    <color:#2E7D32>+ void overlap(training::core::Moment start,</color>
    <color:#2E7D32>    training::core::Moment heardEnd, std::size_t cut)</color>
  }
  note right of SoundEvents
    Обработчик событий звука.
    Связка пишет в журнал
    «warning: audio block overlaps …».
  end note

  class "training::core::Note" as PlacedNote <<новый>> <<struct>> {
    <color:#2E7D32>+ training::core::Interval deviation</color>
  }
  note right of PlacedNote
    Нота звука или MIDI, которая легла в узел:
    разница — отклонение от узла в реальном
    времени, минус — раньше узла.
  end note

  class "training::core::MidiNote" as CoreMidiNote <<новый>> <<struct>> {
    <color:#2E7D32>+ training::core::Moment time</color>
  }

  interface "training::core::MidiReceiver" as MidiReceiver <<новый>> {
    <color:#2E7D32>+ void receive(std::span<const training::core::MidiNote> notes)</color>
  }

  abstract class "training::core::Timeline" as CoreTimeline #FFFFFF {
  }
  note right of CoreTimeline : контракт не меняется

  class "training::core::Bar" as CoreBar <<изменён>> <<struct>> {
  }
  note right of CoreBar
    index — номер такта в запуске, а не в проекте:
    проходы петли получают новые номера. Подпись
    на экране ставит libs/render по сведениям связки.
  end note

  class "training::core::Settings" as CoreSettings <<изменён>> {
    <color:#C62828><s>+ training::core::Input input() const</s></color>
    <color:#C62828><s>+ void setInput(training::core::Input input)</s></color>
    <color:#C62828><s>- training::core::Input input_</s></color>
  }
}

