// Описание форм модуля.
//
// Единственный исходник формы на все платформы. Под SWELL из него порождается
// таблица C++ скриптом WDL/swell/swell_resgen.pl; на Windows тот же файл
// собирает компилятор ресурсов через обёртку forms_win.rc.
//
// Координаты в диалоговых единицах, а не в пикселях: масштаб у платформ разный.

#include "ids.h"

// Окно тренажёра встаёт в док REAPER, поэтому это дочерняя форма без рамки.
// Сверху — настройки и строка состояния, ниже окно рисует строки тактов само.
// Кнопки IDC_CAL_* — кнопки панели калибровки: место и видимость им задаёт
// окно, они стоят поверх области строк, пока идёт калибровка.
IDD_TRAINER DIALOG DISCARDABLE 0, 0, 444, 200
STYLE DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
BEGIN
    LTEXT           "Mode:", IDC_MODE_LABEL, 4, 4, 26, 10
    COMBOBOX        IDC_MODE, 32, 2, 90, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tolerance, ms:", IDC_TOLERANCE_LABEL, 128, 4, 52, 10
    EDITTEXT        IDC_TOLERANCE, 182, 2, 24, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Input:", IDC_CHANNEL_LABEL, 212, 4, 22, 10
    COMBOBOX        IDC_CHANNEL, 236, 2, 80, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CHECKBOX        "Bar numbers", IDC_SHOW_NUMBERS, 324, 3, 56, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    CHECKBOX        "Mean/spread", IDC_SHOW_STATS, 384, 3, 58, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT           "Silence, dBFS:", IDC_SILENCE_LABEL, 4, 20, 52, 10
    EDITTEXT        IDC_SILENCE, 58, 18, 24, 12, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Calibrate...", IDC_CALIBRATE, 88, 18, 50, 12, WS_TABSTOP
    LTEXT           "", IDC_STATUS, 144, 20, 296, 10
    PUSHBUTTON      "Cancel", IDC_CAL_CANCEL, 0, 0, 40, 14, WS_TABSTOP
    PUSHBUTTON      "Apply anyway", IDC_CAL_APPLY, 0, 0, 80, 14, WS_TABSTOP
    PUSHBUTTON      "Calibrate again", IDC_CAL_AGAIN, 0, 0, 64, 14, WS_TABSTOP
    PUSHBUTTON      "Close", IDC_CAL_CLOSE, 0, 0, 40, 14, WS_TABSTOP
END
