value Settings {
  responsibility Настройки ядра.

  enum Hit {
    value Target Попадание точно в момент
    value Good Попадание с отклонением в пределах окна попадания
    value Bad Попадание с отклонением за пределами окна попадания
  }

  value HitWindow {
    responsibility Окно попадания: отклонениe от клика, при которых нота попала.

    field {
      offset: Interval {
        responsibility {
          Смещение окна попадания относительно клика.
          Примеры:
            - 0ms — окно попадания симметрично клику;
            - 10ms — окно попадания смещено на 10 миллисекунд вперёд;
            - −5ms — окно попадания смещено на 5 миллисекунд назад.
        }
      }

      tolerance: Interval {
        responsibility {
          Допуск окна попадания: отклонение от клика, при котором нота попала [Settings.Hit.Good].
          Примеры:
            - 1ms — окно попадания с минимальным допуском;
            - 10ms — окно попадания с допуском в 10 миллисекунд;
        }

        invariant #tolerance Не меньше 1ms.
      }

      exactTolerance: Interval {
        responsibility {
          Допуск окна попадания для точного попадания [Settings.Hit.Target].
            - 10ms — окно попадания с допуском в 10 миллисекунд;
        }

        invariant #lessThanTolerance Не больше tolerance.
        note Значение по умолчани 0.5ms
      }
    }

    action {
      early(): Interval {
        responsibility Возвращает момент времени, раньше которого нота считается - мимо.
        note Равен `offset - tolerance`.
      }

      late(): Interval {
        responsibility Возвращает момент времени, позже которого нота считается - мимо.
        note Равен `offset + tolerance`.
      }

      hit(deviation: Interval): Settings.Hit Определяет попала ли нота в интервал.
    }
  }

  field {
    window: HitWindow Окно попадания.

    silenceDb: float Порог тишины, dBFS.
  }

  action {
    changeSettings(window, silenceDb) {
      responsibility Изменяет настройки ядра.
      note Может быть реализовано несколькими функциями

      arg window: HitWindow Новое окно попадания

      arg silenceDb: float Новый порог тишины, dBFS.
    }
  }
}
