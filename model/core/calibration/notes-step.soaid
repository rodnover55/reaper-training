import training.core.input
import training.core.detector
import training.core

use training.core.input

entity NotesStep: SoundReceiver {
  responsibility Измеряет громкость нот на шаге [training.core.calibration.Step.Notes]

  relation {
    detector: training.core.detector.Detector
  }

  enum {
    Step {
      responsibility Определяет состояние текущего запуска шага.

      invariant #transisions {
        [Step.Off] -> [Step.Loading] -> [Step.Working] -> [Step.Done]
        [Step.Loading] -> [Step.Off]
        [Step.Working] -> [Step.Off]
        [Step.Done] -> [Step.Off]
      }

      value {
        Off Выключен, не работает.
        Loading Запускается. например в тот момент, когда проходит прогрев фильтров.
        Working Выполняет вычисление.
        Done Вычисление завершено.
      }
    }

    Verdict {
      value Good Измерение завершено успешно.
      value NoiseTooClose Уровень шума слишком блико к звучащим нотам.
      value Clipping Вход перегружен.
      value NotEnoughNotes Измерение оборвалось до получение необходимого количества нот.
    }
  }

  value State {
    field {
      step: Step Текущее состояние шага.

      attacksDb: float[] {
        responsibility {
          Значения уровня атаки для каждой найденной ноты, dBFS
          Используется в [Step.Working]
          в [Step.Done] не меняется и сохраняет последнее значение. 
          Для остальных статусов значение не актуально.
        }

        invariant #limit Количество элементов не больше [NotesStep.notes].

        invariant #read-only Только для чтения, снаружи не меняется
      }

      sinceLastNote: training.core.Interval {
        responsibility {
          Время которое прошло начиная с последнй ноты во время [Step.Working].
          Для остальных статусов значение не актуально.
        }

        note {
          Если нот нет len([State.attacksDb]) == 0 то считается с момента [Step.Working].
        }

        invariant #read-only Только для чтения, снаружи не меняется
      }

      levelDb: float {
        responsibility {
          Возвращает уровень текущего сигнала во время [Step.Working].
          Для остальных статусов значение не актуально.
        }

        invariant #read-only Только для чтения, снаружи не меняется
      }

      peakDb: float {
        responsibility {
          Пик сигнала, dBFS: наибольшая абсолютная величина входного сэмпла.
          Используется в [Step.Working]
          в [Step.Done] не меняется и сохраняет последнее значение.
          Для остальных статусов значение не актуально.
        }

        invariant #read-only Только для чтения, снаружи не меняется
      }

      verdict: Verdict {
        responsibility {
          Статус результата
          Возвращается во время [Step.Done].
          Для остальных статусов значение не актуально
        }
        
        invariant #read-only Только для чтения, снаружи не меняется
      }

      thresholdDb: float {
        responsibility {
          Вычисленный порог тишины используемый для определения нот.
          Вычисляется в [Step.Done].
          Для остальных статусов не актуален.
        }
        
        invariant #read-only Только для чтения, снаружи не меняется
      }
    }
  }

  field {
    state: State Состояние работы [NotesStep].

    noiseDb: float {
      responsibility Уровень шума посчтитанный в [training.core.calibration.SilenceStep.State.noiseDb].
    }

    notes: int {
      responsibility Необходимое количество нот для теста
      invariant #default 8
      note ai Опциональное не требует обязательной установки.
    }

    silenceLength: training.core.Interval {
      responsibility Время отсутствия нот, после которого калибровка останавливается
      invariant #default 15s
      note ai Опциональное не требует обязательной установки.
    }
    
    sampleRate: training.core.SampleRate Частота дискретизации
  }

  action {
    constructor create(sampleRate: training.core.SampleRate)
    
    receive(block: AudioBlock) {
      invariant #reuse-filter {
        Считает уровни на основе фильров полученных из [training.core.detector.Detector.filter]
      }

      invariant #working {
        Обновляет [State.attacksDb], [State.levelDb], [State.peakDb], [State.sinceLastNote]
        при [Step.Working]
      }

      invariant #result {
        Обновляет [State.verdict], [State.thresholdDb] при [Step.Done].
      }

      note ai {
        Текущий алгоритм и его зависимости не описываются в этой модели и реализованы сами по себе,
        кроме [NotesStep.receive#reuse-filter]
      }
    }


    start(noiseDb: float) throws training.core.InvalidStep {
      responsibility Запускает шаг

      invariant #loading {
        Переводит [Step.Off] -> [Step.Loading], ждет необходимое время для прогрева фильтров и
        переводит [Step.Loading] -> [Step.Working]
      }

      invariant #isolated {
        [NotesStep.detector] Пересоздается при старте при измененном [noiseDb]. 
      }

      invariant #noise-db-equal {
        Значение полученное из [noiseDb] используется как есть и не пересчитывается после получения.
      }

      note {
        Для [NotesStep.detector] необходим уровень [State.thresholdDb] который еще не вычислен,
        поэтому за этот уровень принимается [noiseDb] + 6Дб.
      }

      error training.core.InvalidStep Возникает, когда [State.step] != [Step.Off]
    }

    stop() Останавливает шаг и сбрасывает внутреннее состояние [NotesStep.state].

    result(): State Возвращает результат [NotesStep.state] на текущий момент.
  }
}