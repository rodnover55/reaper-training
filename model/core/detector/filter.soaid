interface Filter {
  responsibility Базовый интерфейс для фильтров/детектеров

  action {
    process(samples: float[]): float[] {
      responsibility Применяет фильтр на пачку семплов потока и возвращает их обработанными.
      invariant #same-index Каждый выходящий семпл соответствует обаботанному входящему по их порядку.
    }
  }
}

entity Serial: Filter {
  responsibility {
    Создает цепочку фильтров и вызывает их.
  }

  field {
    filters: Filter[] Несколько фильтров, которые вызываются последовательно
  }

  action {
    process(samples: float[]): float[] {
      invariant {
        Вызывает фильтры по очереди и к каждому следующему применяет результат предыдущего.
        Возвращает результат последнего фильтра.
      }

      invariant #same-sample-rate {
        Все фильтры должны рабоать с одной частой.
      }

      invariant #empty {
        Если фильтров нет, возвращается неизмененный массив.
      }
    }
  }
}