entity Buffer<T> {
  responsibility {
    Циклический буфер фиксированного размера, который удаляет старые элементы при переполнении
  }

  link https://en.wikipedia.org/wiki/Circular_buffer Кольцевой буфер: атака с номером n лежит в ячейке n по модулю размера буфера.

  field {
    capacity: int {
      responsibility Размер буфера.
    }
  }

  note ai Предпочтительно использовать готовые реализации буфера.

  error {
    Empty Возникает при запросе элемента в пустом буфере.
  }

  action {
    push(onset: T) {
      responsibility Дописывает элемент в буфер.
      invariant #overflow При переполнении буфера самый старый элемент выбрасывается
    }

    pop(): T throws Empty {
      responsibility Возвращает самый старый добавленный элемент и убирает его из буфера.
      error Empty Когда буфер пуст.
    }

    clear() Очищает буфер.
  }
}
