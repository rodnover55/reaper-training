interface Value {
  responsibility Возвращает значение для вычисления максимума

  action {
    value(): float
  }
}

entity SlidingMax<T: Value> {
  responsibility Вычисляет наибольшее значение семпла за отрезок времени в семплах.

  value SampleValue<T: inherit> {
    responsibility Хранит значение семпла по его индексу.

    field {
      index: int
      value: T
    }
  }

  field {
    capacity: int {
      responsibility Размер проверяемого отрезка в семплах.
      invariant #positive Больше 0
    }
  }

  note {
    Хранит в себе область памяти размером [SlidingMax.capacity] для сохранения [SampleValue].
  }

  action {
    reset() Сбрасывает накопленный результат и запускает вычисление сначала.

    process(samples: SampleValue<T>[]): SampleValue<T>[] {
      responsibility Обрабатывает входные семплы и вычисляет максимумы.
      invariant #ordered Каждый следующий [SampleValue] должен быть новее предыдущего.
      invariant #same-index Каждое выходящее значение соответствует максимум в каждый переданный момент времени.

      invariant #earliest {
        Если наибольшее значение окна повторяется на нескольких сэмплах подряд, 
        возвращается первый из этих сэмплов.
      }

      note {
        Сам вычисляет и учитывает пройденное время для исключения элементов раньше [SlidingMax.capacity].
      }

      note {
        Для каждого переданного сэмпла `s` из [samples]:

        1. С головы удаляются элементы, вышедшие из окна: `index` не больше `s.index − capacity`.
        2. С конца удаляются элементы со значением строго меньше `s` — они уже не станут максимумом,
           пока `s` в окне. 
        3. `s` добавляется в конец.
        4. Голова очереди показывает максимум окна на сэмпле `s`.
      }

      dependency Value Использует [Value.value] для получение значения переданного элемента.
    }
  }
}
