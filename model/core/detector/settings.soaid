import training.core

use training.core

value Settings {
  responsibility Параметры поиска атаки [Detector].

  note ai {
    Конфигурация алгоритма и его зависимостей не рассматриваются в этой модели.
  }
  
  field {
    sampleRate: float {
      responsibility Частота дискретизации потока, Гц.
      invariant #positive Больше нуля.
      note Значение по умолчанию 44100.
    }

    silenceDb: float {
      responsibility {
        Порог тишины, dBFS: атака, у которой огибающая после ВЧ-фильтра не доходит до порога, не находится.
      }
      note {
        Щелчок медиатора после ВЧ-фильтра тише пика всего сигнала: на тихом DI-входе — примерно на 30 дБ.
        Значение по умолчанию −50.
      }
    }
  }
}
