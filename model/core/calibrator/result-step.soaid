import training.core.input
import training.core
import training.core.detector

use training.core.input

entity ResultStep: SoundReceiver {
  responsibility {
    Завершает процесс вычисления.
    Ждет звука, чтобы остановиться.
  }

  relation {
    detector: training.core.detector.Detector
  }

  enum {
    Step {
      responsibility Определяет состояние текущего запуска шага.

      invariant #transisions {
        [Step.Off] -> [Step.Loading] -> [Step.Working] -> [Step.Done]
        [Step.Loading] -> [Step.Off]
        [Step.Working] -> [Step.Off]
        [Step.Done] -> [Step.Off]
      }

      value {
        Off Выключен, не работает.
        Loading Запускается. Ждет [ResultStep.waitTime] секунд до начала прослушивания звукового потока
        Working Ждет звука в потоке.
        Done Вычисление завершено.
      }
    }
  }

  field {
    step: Step

    waitTime: training.core.Interval {
      responsibility Через какое время слушать сигнал.
      invariant #default 5s
      note ai Опциональное не требует обязательной установки.
    }

    thresholdDb: float Порог сигнала, по которому определяется звук.
  }

   action {
    receive(block: AudioBlock) {
      body {
        После достижения [ResultStep.waitTime] 
        переводит [Step.Loading] -> [Step.Working] и ждет звука из потока.
        После этого [Step.Working] -> [Step.Done].
      }
      
      invariant #reuse-filter {
        Считает уровни на основе фильров полученных из [training.core.detector.Detector.filter]
      }

      note ai {
        Логика определения уровня сигнала не рассматривается в этой модели.
        Используется как есть в коде.
      }
    }


    start(thresholdDb: float) throws InvalidStep {
      responsibility Запускает шаг

      body {
        Переводит [Step.Off] -> [Step.Loading] и ждет [ResultStep.waitTime].
      }
      error InvalidStep Возникает, когда [ResultStep.step] != [Step.Off]
    }

    stop() Останавливает шаг.
  }
}
